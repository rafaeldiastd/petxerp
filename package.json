{
  "name": "petxerp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "vue-tsc -b",
    "cf-typegen": "wrangler types --env-interface Env server/worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.dev.vars --experimental-strip-types scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lucide/vue": "^1.70.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/vue-query": "^5.106.1",
    "@vueuse/core": "^15.0.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
